# EggBloom Desktop 环境变量模板
# 复制为 .env 并填入你的真实值
# 注意：API Key 推荐通过 WebUI 设置，将写入 Windows 凭据管理器，不落盘明文

# ===== API 配置 =====
# DeepSeek / OpenAI 兼容 API Key（获取地址：https://platform.deepseek.com/）
API_KEY=sk-your-api-key-here

# API 端点（根据 provider 自动填充，通常无需手动修改）
# DeepSeek: https://api.deepseek.com/chat/completions
# OpenAI: https://api.openai.com/v1/chat/completions
# Ollama: http://localhost:11434/v1/chat/completions
# LM Studio: http://localhost:1234/v1/chat/completions
API_URL=https://api.deepseek.com/chat/completions

# 模型名称
# DeepSeek: deepseek-chat, deepseek-reasoner, deepseek-v4-flash
# Ollama: qwen2.5:7b, llama3.1:8b, deepseek-r1:7b
MODEL_NAME=deepseek-v4-flash

# ===== Bot 配置（可选，通常在 WebUI 设置）=====
# Bot QQ 号（登录协议驱动后自动获取）
# BOT_QQ=YOUR_BOT_QQ

# OneBot HTTP API 地址（协议驱动启动后的地址）
# ONE_BOT_URL=http://127.0.0.1:3000

# OneBot Token（如协议驱动配置了鉴权）
# ONE_BOT_TOKEN=

# ===== 协议驱动路径（可选，通常在 WebUI 协议面板配置）=====
# NapCat 可执行文件路径
# NAPCAT_EXE_PATH=

# QQNT 可执行文件路径
# QQ_PATH=

# SnowLuma node.exe 路径
# SNOWLUMA_NODE_PATH=

# ===== 本地模型路径（可选，用于 llama-server / embedding）=====
# llama-server 可执行文件
# LLAMA_SERVER_EXE=

# llama-server 模型文件路径
# LLAMA_MODEL_PATH=

# Embedding 模型服务地址（默认 llama-server embedding 端口）
# EMBED_URL=http://127.0.0.1:8083/v1/embeddings

# ===== 其他可选配置 =====
# ComfyUI 地址（用于 AI 绘图）
# COMFYUI_HOST=127.0.0.1
# COMFYUI_PORT=8000

# 日志级别：DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO