# Windows 脚本必须 CRLF，否则 start.bat 在某些环境下会解析失败
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# sh 钩子必须 LF：CRLF 的 `#!/bin/sh` 脚本在 Git for Windows 下报
# `bad interpreter: /bin/sh^M`，整道闸静默失效。core.autocrlf=true 的机器
# 检出时会把这些文件转成 CRLF，所以得在这里钉住。
.githooks/*  text eol=lf

# 二进制：不要让 git 尝试合并/换行
*.ttf    binary
*.woff2  binary
*.png    binary
*.ico    binary
*.zip    binary
*.db     binary
*.gguf   binary
*.dll    binary
*.exe    binary
